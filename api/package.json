{
  "name": "gatherly-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migrate": "dotenv run -f .env.staging -- npx prisma migrate dev --name new-migration && dotenv run -f .env.staging -- npx prisma generate && dotenv run -f .env.staging -- npx prisma migrate deploy && dotenv run -f .env.staging -- nest start --watch",
    "migrate:local": "dotenv run -f .env.local -- npx prisma migrate dev --name new-migration && npx prisma generate",
    "migrate:dev": "dotenv run -f .env.development -- npx prisma migrate dev --name init && npx prisma generate",
    "migrate:prod": "dotenv run -f .env.production -- npx prisma migrate deploy",
    "migrate:staging": "dotenv run -f .env.staging -- npx prisma migrate dev --name init && npx prisma generate",
    "studio:local": "npx dotenv run -f .env.local -- npx prisma studio",
    "studio:dev": "npx dotenv run -f .env.development -- npx prisma studio",
    "studio:prod": "npx dotenv run -f .env.production -- npx prisma studio",
    "studio:staging": "npx dotenv run -f .env.staging -- npx prisma studio",
    "reset:dev": "npx dotenv run -f .env.development -- npx prisma migrate reset",
    "start": "nest start",
    "start:local": "npx dotenv run -f .env.local -- nest start  --watch",
    "start:dev": "npx dotenv run -f .env.development -- nest start --watch",
    "start:staging": "npx dotenv run -f .env.staging -- nest start --watch",
    "start:prod": "npx dotenv run -f .env.production -- node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "debug:dev": "npx dotenv run -f .env.development -- node --inspect-brk -r tsconfig-paths/register -r ts-node/register ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:worker": "nest start --entryFile worker",
    "start:worker:staging": "npx dotenv run -f .env.staging -- nest start --watch --entryFile worker",
    "start:worker:local": "npx dotenv run -f .env.local -- nest start --watch --entryFile worker",
    "start:worker:prod": "npx dotenv run -f .env.production -- node dist/src/worker",
    "migrate:deploy": "prisma migrate deploy",
    "postbuild": "node -e \"require('fs').cpSync('src/generated','dist/src/generated',{recursive:true})\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.101",
    "@apollo/server": "^5.5.1",
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@elastic/elasticsearch": "^9.5.1",
    "@google-cloud/storage": "^8.4.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/elasticsearch": "^12.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node-telegram-bot-api": "^0.64.15",
    "ai": "^7.0.150",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "bullmq": "^6.4.0",
    "cache-manager": "^7.2.9",
    "cache-manager-memory-store": "^1.1.0",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "graphql": "^16.11.0",
    "graphql-fields": "^2.0.3",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "latest": "^0.2.0",
    "luxon": "^3.7.2",
    "node-telegram-bot-api": "^2.1.0",
    "nodemailer": "^10.2.1",
    "otp-generator": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.2.0",
    "twitter-api-v2": "^1.29.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/otp-generator": "^4.0.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^generated/(.*)$": "<rootDir>/generated/$1",
      "^@nestjs/common$": "<rootDir>/../test/nest-common.shim.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
