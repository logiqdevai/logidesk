# ─── LogiDesk API — environment variables ─────────────────────────────────────
# Copy to .env.<NODE_ENV> (e.g. .env.staging). Required values are marked (required).

# Environment: local | development | test | staging | production   (required)
NODE_ENV=staging
PORT=3000

# Public URLs. APP_URL is used in emails (portal / invitation / reset links) and for
# framing inline document previews. API_URL is the public base of this API (incl. /api).
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api
LANDING_URL=
# Comma-separated list of allowed browser origins (defaults to APP_URL + LANDING_URL)
CORS_URLS=

# PostgreSQL (required). For RLS enforcement connect with a role that is NOT a superuser
# and does not have BYPASSRLS; migrations/workers may use a privileged role.
DATABASE_URL=postgres://user:password@host:5432/logidesk

# Redis (required): BullMQ queues, schedulers, locks, rate limiting, short-lived caches.
REDIS_URL=redis://default:password@host:6379/0

# Auth (required). Access tokens live 1 hour; refresh tokens 30 days (rotated on use).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_TIME=1h

# ─── Email (notifications) ────────────────────────────────────────────────────
# Resend is the default provider. EMAIL_FROM must be a verified sender domain in Resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=notifications@yourdomain.com
# Optional SMTP provider (select per organization in Settings > Notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=
# Development only: when no provider is configured, emails are written here instead of sent.
EMAIL_OUTBOX_DIR=.outbox

# ─── Document storage ─────────────────────────────────────────────────────────
# Google Cloud Storage private bucket (production). Downloads use 5-minute V4 signed URLs.
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_JSON_BASE64=
# Without GCS, files are kept in this private directory and served via signed tokens.
STORAGE_LOCAL_DIR=.storage

# ─── Background jobs ──────────────────────────────────────────────────────────
# job_runs retention (days) enforced by the MAINTENANCE queue
JOB_RUNS_RETENTION_COMPLETED_DAYS=30
JOB_RUNS_RETENTION_FAILED_DAYS=90
# Basic-auth credentials for Bull Board at /admin/queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me

# ─── Phase 2 (not used yet) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
