# Base URL of the LogiDesk API (including the /api prefix)
VITE_API_URL=http://localhost:3000/api
# Public URL of this web app (used for the public portal link)
VITE_APP_URL=http://localhost:5173
# Set to "true" to hide UI that is only for admin / super admin accounts (unset or "false" shows it)
VITE_HIDE_ADMIN_UI=false
